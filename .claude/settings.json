{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run opskit-review:*)",
      "Bash(uv run opskit-evals:*)",
      "Bash(uv run opskit-audit-verify:*)",
      "Bash(uv sync:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform plan:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.audit/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(./.claude/settings.json)",
      "Edit(./.github/workflows/**)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git push --force:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet python .claude/hooks/guard_pretool.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet python .claude/hooks/post_edit_review.py"
          }
        ]
      }
    ]
  }
}
